# Copy to .env and fill in real values. Never commit .env itself.
#
# Local dev (Section 12.1): run Neo4j as a local container, no account
# needed (External Services Provisioning Guide) -
#   docker run -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/localdevpassword neo4j:5-community
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=localdevpassword
#
# Staging/prod (Section 12.1): Neo4j AuraDB - same three variables, no code
# changes needed. From the Aura instance page:
#   NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
#   NEO4J_USERNAME=neo4j
#   NEO4J_PASSWORD=<the password Aura shows exactly once at instance creation>

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=localdevpassword
